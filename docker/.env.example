# Used by docker compose only; the application reads the .env at the repository root.

# Host user the containers write files as; set to the output of id -u and id -g
UID=1000
GID=1000

# Passwords of the postgres superuser, the api role the application connects
# as and the tw2-stats role that owns the world databases
DB_ROOT_PASSWORD=
DB_PASSWORD=
DB_ADMIN_PASSWORD=
